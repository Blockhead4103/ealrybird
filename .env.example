# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Die Datei .env wird NICHT in Git hochgeladen (siehe .gitignore).

# --- E-Mail (Beispiel Gmail) ---
# Gmail braucht ein "App-Passwort" (nicht dein normales Passwort).
# Anleitung: Google-Konto -> Sicherheit -> 2-Schritt-Verifizierung aktivieren -> App-Passwörter
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine.adresse@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=deine.adresse@gmail.com

# --- Optional: KI zur Skill-Erkennung (leer lassen = kostenlose lokale Erkennung) ---
# Jeder Anbieter mit "OpenAI-kompatibler" Schnittstelle funktioniert, z.B.
#   Ollama lokal (gratis, läuft auf deinem PC): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1
#   Groq (Gratis-Kontingent, Stand bitte prüfen): LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Nur für Online-Betrieb wichtig ---
# Passwort-Schutz der App (leer = kein Passwort)
APP_PASSWORD=
# Erlaubte Empfänger, mit Komma getrennt (leer = alle)
ALLOWED_EMAILS=
